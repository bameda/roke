{
  "description": "PostgreSQL: schemas and SQL on the project's database",
  "command": [
    "npx",
    "-y",
    "@toolbox-sdk/server@1.17.0",
    "--prebuilt=postgres",
    "--stdio"
  ],
  "env": {
    "POSTGRES_HOST": "postgres",
    "POSTGRES_PORT": "5432",
    "POSTGRES_DATABASE": "${POSTGRES_DB:-app}",
    "POSTGRES_USER": "${POSTGRES_USER:-dev}",
    "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:-dev}"
  },
  "services": [
    "postgres"
  ]
}
