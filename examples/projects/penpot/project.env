# Penpot's repository, with Penpot's own development environment (devenv)
# running Penpot, and roke isolating the agent. See README.md.

# No services: the devenv runs PostgreSQL, Valkey, RustFS, Mailpit and LDAP.

# Serena reads the code (Clojure, ClojureScript, JavaScript, Rust). Use
# roke's, not the devenv's.
ROKE_SERENA=1

# The Penpot MCP server the devenv runs on your machine, when started with
# ./manage.sh run-devenv --agentic. Remove it if you do not use it.
ROKE_MCPS=penpot-devenv
