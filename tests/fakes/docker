#!/usr/bin/env python3
"""A fake `docker` for the tests: it records every call instead of running it.

Each call is appended as a JSON line to $FAKE_DOCKER_LOG, with its arguments
and the environment variables roke exports for Docker Compose. Behaviour
can be tuned with environment variables:

  FAKE_RUNNING=1          the project's gateway is reported as running
  FAKE_NO_IMAGE=1         `docker image inspect` fails (image not built)
  FAKE_COMPOSE_LS="a b"   projects listed by `docker compose ls -q`
  FAKE_REAL_COMPOSE=PATH  pass `docker compose ... config` to a real
                          docker-compose binary, to validate configurations
"""

import json
import os
import subprocess
import sys

args = sys.argv[1:]
exported = {
    k: v
    for k, v in os.environ.items()
    if k.startswith(("ROKE_", "HOST_", "POSTGRES_", "MAILPIT_"))
    or k.endswith("_VERSION")
    or k == "PROJECT_DIR"
}
with open(os.environ["FAKE_DOCKER_LOG"], "a") as log:
    log.write(json.dumps({"args": args, "env": exported}) + "\n")

# Running containers: sessions (FAKE_SESSIONS="claude,codex", one-off runs of
# the box) and services (FAKE_RUNNING_HASHES="gateway=h1,postgres=h2").
if args[:1] == ["version"]:
    if "FAKE_DOCKER_VERSION_OUTPUT" in os.environ:
        print(os.environ["FAKE_DOCKER_VERSION_OUTPUT"])
        sys.exit(0)
    data = {"Client": {"Version": "28.1.0-fake"}}
    failed = os.environ.get("FAKE_DOCKER_FAIL") == "info"
    if not failed:
        data["Server"] = {"Version": "27.5.0-fake"}
    print(json.dumps(data))
    sys.exit(1 if failed else 0)
if args[:1] == ["info"]:
    sys.exit(1 if os.environ.get("FAKE_DOCKER_FAIL") == "info" else 0)
if args[:1] == ["ps"]:
    if os.environ.get("FAKE_DOCKER_FAIL") == "ps":
        print("daemon unavailable", file=sys.stderr)
        sys.exit(1)
    if os.environ.get("FAKE_BAD_PS"):
        print("invalid container list")
        sys.exit(0)
    for agent in filter(None, os.environ.get("FAKE_SESSIONS", "").split(",")):
        print(f"box\tTrue\t\tsess-{agent}")
    for item in filter(None, os.environ.get("FAKE_RUNNING_HASHES", "").split(",")):
        service, hash_ = item.split("=", 1)
        print(f"{service}\tFalse\t{hash_}\tid-{service}")
    sys.exit(0)
if args[:1] == ["inspect"]:
    if os.environ.get("FAKE_DOCKER_FAIL") == "inspect":
        print("container disappeared", file=sys.stderr)
        sys.exit(1)
    if os.environ.get("FAKE_BAD_INSPECT"):
        print("invalid response")
        sys.exit(0)
    container = args[-1]
    if container.startswith("sess-"):
        print(json.dumps([f"ROKE_AGENT={container[5:]}"]))
    sys.exit(0)
if args[:1] in (["volume"],):
    sys.exit(0)
if args[:2] == ["image", "inspect"]:
    sys.exit(1 if os.environ.get("FAKE_NO_IMAGE") else 0)
if args[:1] == ["run"]:
    # `docker run ... --entrypoint python3 IMAGE -c SCRIPT`: run the script here.
    script = args[args.index("-c") + 1]
    sys.exit(subprocess.run([sys.executable, "-c", script]).returncode)
if args[:1] == ["compose"]:
    rest = args[1:]
    if "logs" in rest and os.environ.get("FAKE_LOGS_ERROR"):
        if os.environ["FAKE_LOGS_ERROR"] == "service":
            print("no such service: missing", file=sys.stderr)
        else:
            print("unknown flag: --bad", file=sys.stderr)
        sys.exit(1)
    if rest[:1] == ["version"]:
        print("Docker Compose version v5.0.0-fake")
        sys.exit(0)
    if "ls" in rest:
        if os.environ.get("FAKE_DOCKER_FAIL") == "ls":
            print("daemon unavailable", file=sys.stderr)
            sys.exit(1)
        print("\n".join(os.environ.get("FAKE_COMPOSE_LS", "").split()))
        sys.exit(0)
    failed_project = os.environ.get("FAKE_DOWN_FAIL")
    if "down" in rest and failed_project and failed_project in rest:
        print("cannot stop project", file=sys.stderr)
        sys.exit(1)
    if "ps" in rest:
        if os.environ.get("FAKE_COMPOSE_FAIL") == "ps":
            print("daemon unavailable", file=sys.stderr)
            sys.exit(1)
        if os.environ.get("FAKE_RUNNING"):
            print("0123456789ab")
        sys.exit(0)
    if "exec" in rest and "blocked" in rest:
        print("Domains the project looked up and were not allowed:")
        print("  blocked.example.com                                1 lookups")
        print("  news.oraios-software.de                            2 lookups")
        sys.exit(0)
    if "config" in rest:
        if os.environ.get("FAKE_BAD_CONFIG"):
            print("services: {}")
            sys.exit(0)
        if os.environ.get("FAKE_COMPOSE_FAIL") == "config":
            print(os.environ.get("FAKE_COMPOSE_ERROR", "invalid compose file"), file=sys.stderr)
            sys.exit(1)
        if "--services" in rest:
            print(os.environ.get("FAKE_COMPOSE_SERVICES", "box\ngateway"))
            sys.exit(0)
        real = os.environ.get("FAKE_REAL_COMPOSE")
        if real and "--hash" in rest:
            # Record the hashes, so tests can compare them between runs.
            out = subprocess.run([real, *rest], capture_output=True, text=True)
            with open(os.environ["FAKE_DOCKER_LOG"], "a") as log:
                log.write(json.dumps({"args": ["hashes"], "stdout": out.stdout}) + "\n")
            print(out.stdout, end="")
            sys.exit(out.returncode)
        if real:
            sys.exit(subprocess.run([real, *rest]).returncode)
        if "--hash" in rest:
            for item in filter(None, os.environ.get("FAKE_CONFIG_HASHES", "").split(",")):
                print(" ".join(item.split("=", 1)))
            sys.exit(0)
        print(
            json.dumps(
                {"services": {"box": {"image": os.environ.get("ROKE_BOX_IMAGE", "roke:latest")}}}
            )
        )
        sys.exit(0)
sys.exit(0)
