#!/usr/bin/env bash
# roke: run a coding agent in a container that can only see the project.
# The command itself is the Python package next to this script (roke/).
set -euo pipefail
repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"

if ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
  echo "roke: needs Python 3.10 or newer (python3)" >&2
  exit 1
fi
PYTHONPATH="$repo${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m roke "$@"
