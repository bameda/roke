# Personal configuration lives in ~/.config/roke, never in this repository.
# These patterns guard against files left over from older layouts.
.env
/projects/
/config/

# Python caches: pytest, ruff, mypy
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Serena's state for each person (project config and memories)
.serena/
