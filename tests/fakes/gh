#!/usr/bin/env python3
"""GitHub release state for release-script tests; never contacts GitHub."""

import json
import os
import sys
from pathlib import Path

args = sys.argv[1:]
with open(os.environ["FAKE_GH_LOG"], "a") as log:
    log.write(json.dumps(args) + "\n")
state_file = Path(os.environ["FAKE_GH_STATE"])
state = json.loads(state_file.read_text())
operation = args[1]
if os.environ.get("FAKE_GH_FAIL") == operation:
    sys.exit("simulated GitHub failure")
if operation == "list":
    print(json.dumps(list(state.values())))
    sys.exit(0)
tag = args[2]
if operation == "view":
    if tag not in state:
        sys.exit(1)
    print(json.dumps(state[tag]))
    sys.exit(0)
if operation == "create":
    if tag in state:
        sys.exit("release already exists")
    state[tag] = {"tagName": tag, "isDraft": True, "isPrerelease": False, "assets": {}}
elif operation == "upload":
    for name in args[3 : args.index("--clobber")]:
        path = Path(name)
        state[tag]["assets"][path.name] = path.read_text()
elif operation == "edit":
    state[tag]["isDraft"] = False
if "--notes-file" in args:
    state[tag]["notes"] = Path(args[args.index("--notes-file") + 1]).read_text()
state_file.write_text(json.dumps(state))
