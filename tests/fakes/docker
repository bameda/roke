#!/usr/bin/env python3
"""A fake `docker` for the tests: it records every call instead of running it.

Each call is appended as a JSON line to $FAKE_DOCKER_LOG, with its arguments
and the environment variables roke exports for Docker Compose. Behaviour
can be tuned with environment variables:

  FAKE_RUNNING=1          the project's gateway is reported as running
  FAKE_NO_IMAGE=1         `docker image inspect` fails (image not built)
  FAKE_COMPOSE_LS="a b"   projects listed by `docker compose ls -q`
  FAKE_REAL_COMPOSE=PATH  pass `docker compose ... config` to a real
                          docker-compose binary, to validate configurations
"""

import json
import os
import subprocess
import sys

args = sys.argv[1:]
exported = {
    k: v
    for k, v in os.environ.items()
    if k.startswith(("ROKE_", "HOST_", "POSTGRES_", "MAILPIT_"))
    or k.endswith("_VERSION")
    or k == "PROJECT_DIR"
}
with open(os.environ["FAKE_DOCKER_LOG"], "a") as log:
    log.write(json.dumps({"args": args, "env": exported}) + "\n")

if args[:1] in (["volume"],):
    sys.exit(0)
if args[:2] == ["image", "inspect"]:
    sys.exit(1 if os.environ.get("FAKE_NO_IMAGE") else 0)
if args[:1] == ["run"]:
    # `docker run ... --entrypoint python3 IMAGE -c SCRIPT`: run the script here.
    script = args[args.index("-c") + 1]
    sys.exit(subprocess.run([sys.executable, "-c", script]).returncode)
if args[:1] == ["compose"]:
    rest = args[1:]
    if rest[:1] == ["version"]:
        print("Docker Compose version v5.0.0-fake")
        sys.exit(0)
    if "ls" in rest:
        print("\n".join(os.environ.get("FAKE_COMPOSE_LS", "").split()))
        sys.exit(0)
    if "ps" in rest:
        if os.environ.get("FAKE_RUNNING"):
            print("0123456789ab")
        sys.exit(0)
    if "exec" in rest and "blocked" in rest:
        print("Domains the project looked up and were not allowed:")
        print("  blocked.example.com                                1 lookups")
        sys.exit(0)
    if "config" in rest:
        real = os.environ.get("FAKE_REAL_COMPOSE")
        if real:
            sys.exit(subprocess.run([real, *rest]).returncode)
        print("services: {}")
        sys.exit(0)
sys.exit(0)
